    {
      "name": "create_session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    ",
              "    if (response.status === \"OK\") {",
              "        // Save tokens to COLLECTION variables",
              "        if (response.accessToken?.token) {",
              "            pm.collectionVariables.set(\"access_token\", response.accessToken.token);",
              "            console.log(\"✓ Access token saved to collection\");",
              "        }",
              "        ",
              "        if (response.refreshToken?.token) {",
              "            pm.collectionVariables.set(\"refresh_token\", response.refreshToken.token);",
              "            console.log(\"✓ Refresh token saved to collection\");",
              "        }",
              "        ",
              "        // Save session info",
              "        if (response.session?.handle) {",
              "            pm.collectionVariables.set(\"session_handle\", response.session.handle);",
              "        }",
              "        ",
              "        if (response.session?.userId) {",
              "            pm.collectionVariables.set(\"user_id\", response.session.userId);",
              "        }",
              "        ",
              "        // Log expiry",
              "        if (response.accessToken?.expiry) {",
              "            const expiryDate = new Date(response.accessToken.expiry);",
              "            console.log(`  Token expires: ${expiryDate.toLocaleString()}`);",
              "        }",
              "    } else {",
              "        console.log(\"❌ Session creation failed:\", response.status);",
              "    }",
              "} else {",
              "    console.log(\"❌ Request failed with status:\", pm.response.code);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
