              "\t\t}",
              "",
              "\t\tif (response.refreshToken?.token) {",
              "\t\t\tpm.collectionVariables.set(\"refresh_token\", response.refreshToken.token);",
              "\t\t\tconsole.log(\"✓ Refresh token saved to collection\");",
              "\t\t}",
              "",
              "\t\t// Save session info",
              "\t\tif (response.session?.handle) {",
              "\t\t\tpm.collectionVariables.set(\"session_handle\", response.session.handle);",
              "\t\t}",
              "",
              "\t\tif (response.session?.userId) {",
