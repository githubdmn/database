    {
      "name": "verify_session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    ",
              "    if (response.status === \"OK\" && response.session) {",
              "        // Save session information",
              "        pm.collectionVariables.set(\"verified_session_handle\", response.session.handle);",
              "        pm.collectionVariables.set(\"verified_user_id\", response.session.userId);",
              "        ",
              "        console.log(\"✅ Session verified successfully!\");",
              "        console.log(\"  Session Handle:\", response.session.handle);",
              "        console.log(\"  User ID:\", response.session.userId);",
              "        console.log(\"  Tenant ID:\", response.session.tenantId);",
              "    } else {",
              "        console.log(\"❌ Verification failed:\", response.status);",
              "    }",
              "} else if (pm.response.code === 401) {",
              "    console.log(\"❌ Token expired or invalid\");",
              "    console.log(\"  → Create a new session with POST /recipe/session\");",
              "} else {",
              "    console.log(\"❌ Request failed with status:\", pm.response.code);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const accessToken = pm.collectionVariables.get(\"access_token\");",
              "",
              "if (!accessToken) {",
              "    console.log(\"❌ No access token found! Run 'Create Session' first.\");",
              "} else {",
              "    // Set the request body",
              "    pm.request.body.raw = JSON.stringify({",
              "        accessToken: accessToken,",
              "        doAntiCsrfCheck: false,",
              "        enableAntiCsrf: false,",
              "        checkDatabase: true",
              "    });",
              "    ",
              "    console.log(\"✓ Added access token to request body\");",
              "}",
              "",
              "// Add required headers",
              "pm.request.headers.add({ key: \"rid\", value: \"session\" });"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
