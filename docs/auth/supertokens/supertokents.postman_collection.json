    {
      "name": "create_user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    ",
              "    if (response.status === \"OK\") {",
              "        // Save user ID",
              "        if (response.user?.id) {",
              "            pm.collectionVariables.set(\"user_id\", response.user.id);",
              "            console.log(\"✓ User ID saved:\", response.user.id);",
              "        }",
              "        ",
              "        // Save recipe user ID",
              "        if (response.recipeUserId) {",
              "            pm.collectionVariables.set(\"recipe_user_id\", response.recipeUserId);",
              "            console.log(\"✓ Recipe User ID saved:\", response.recipeUserId);",
              "        }",
              "        ",
              "        // Save email (useful for sign in)",
              "        if (response.user?.emails && response.user.emails.length > 0) {",
              "            pm.collectionVariables.set(\"user_email\", response.user.emails[0]);",
              "            console.log(\"✓ User email saved:\", response.user.emails[0]);",
              "        }",
              "        ",
              "        // Save tenant ID",
              "        if (response.user?.tenantIds && response.user.tenantIds.length > 0) {",
              "            pm.collectionVariables.set(\"tenant_id\", response.user.tenantIds[0]);",
              "            console.log(\"✓ Tenant ID saved:\", response.user.tenantIds[0]);",
              "        }",
              "        ",
              "        // Save time joined (for debugging)",
              "        if (response.user?.timeJoined) {",
              "            const joinDate = new Date(response.user.timeJoined);",
              "            console.log(\"  User joined:\", joinDate.toLocaleString());",
              "        }",
              "        ",
              "        // Optional: Save entire user object for reference",
              "        pm.collectionVariables.set(\"user_object\", JSON.stringify(response.user));",
              "        ",
              "    } else if (response.status === \"EMAIL_ALREADY_EXISTS_ERROR\") {",
              "        console.log(\"⚠️ User already exists with this email\");",
              "        console.log(\"  Message:\", response.message);",
              "    } else {",
              "        console.log(\"❌ User creation failed:\", response.status);",
              "    }",
              "} else {",
              "    console.log(\"❌ Request failed with status:\", pm.response.code);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
